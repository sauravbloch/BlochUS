      {% include 'ninjacoderz_sitemap_noindex' %}
  
      {% capture seo_title %}
        {{ page_title }}
        {% if current_tags %}
          {%- assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags -}}
        {% endif %}
        {% if current_page != 1 %}
          &ndash; {{ 'general.meta.page' | t: page: current_page }}
        {% endif %}
        {% unless page_title contains shop.name %}
          &ndash; {{ shop.name }}
        {% endunless %}
      {% endcapture %}
      <title>{{ seo_title }}</title>
  
      {% render 'social-meta-tags' %}
  
      {{ 'styles.css' | asset_url | stylesheet_tag }}
      {{ 'custom.css' | asset_url | stylesheet_tag }}
      {{ 'tablet.css' | asset_url | stylesheet_tag: media: 'screen and (min-device-width: 768px) and (max-device-width: 1024px) and (orientation: portrait) and (-webkit-min-device-pixel-ratio: 1)' }}
      {{ 'responsive.css' | asset_url | stylesheet_tag: media: 'screen and (max-width: 767px)' }}
      {{ 'old-styles.css' | asset_url | stylesheet_tag }}
      {{ 'dialog.css' | asset_url | stylesheet_tag }}
      {{ 'swatches.css' | asset_url | stylesheet_tag }}
      
      <script>
        document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
        window.theme = window.theme || {};
        window.slate = window.slate || {};
        theme.moneyFormatWithCodeForProductsPreference = {% if settings.product_currency_code_enabled %}
          {{ shop.money_with_currency_format | json }}
        {% else %}
          {{ shop.money_format | json }}
        {% endif %};
        theme.moneyFormatWithCodeForCartPreference = {% if settings.cart_currency_code_enabled %}
          {{ shop.money_with_currency_format | json }}
        {% else %}
          {{ shop.money_format | json }}
        {% endif %};
        theme.moneyFormat = {{ shop.money_format | json }};
        theme.strings = {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          addressError: {{ 'map.errors.address_error' | t | json }},
          addressNoResults: {{ 'map.errors.address_no_results' | t | json }},
          addressQueryLimit: {{ 'map.errors.address_query_limit_html' | t | json }},
          authError: {{ 'map.errors.auth_error' | t | json }},
          addingToCart: {{ 'products.product.adding_to_cart' | t | json }},
          addedToCart: {{ 'products.product.added' | t | json }},
          addedToCartPopupTitle: {{ 'layout.cart.added_title' | t | json }},
          addedToCartPopupItems: {{ 'layout.cart.items' | t | json }},
          addedToCartPopupSubtotal: {{ 'layout.cart.subtotal' | t | json }},
          addedToCartPopupGoToCart: {{ 'layout.cart.go_to_cart' | t | json }},
          cartTermsNotChecked: {{ 'cart.terms.confirmation' | t | json }},
          searchLoading: {{ 'layout.header.search_loading' | t | json }},
          searchMoreResults: {{ 'layout.header.search_more_results' | t | json }},
          searchResultsCount: {{ 'layout.header.search_results_count' | t | json }},
          searchNoResults: {{ 'layout.header.search_no_results' | t | json }},
          priceFrom: {{ 'products.product.from_text' | t | json }},
          quantityTooHigh: {{ 'cart.general.quantity_too_high' | t: quantity: '[[ quantity ]]' | json }},
          onSale: {{ 'products.product.on_sale' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          in_stock: {{ 'products.labels.in_stock' | t | json }},
          low_stock: {{ 'products.labels.low_stock' | t | json }},
          only_x_left: {{ 'products.labels.only_x_left' | t: quantity: '[[ quantity ]]' | json }},
          single_unit_available: {{ 'products.labels.single_unit_available' | t | json }},
          x_units_available: {{ 'products.labels.x_units_available' | t: quantity: '[[ quantity ]]' | json }},
          unitPriceSeparator: {{ 'products.product.unit_price_separator' | t | json }},
          close: {{ 'general.accessibility_labels.close' | t | json }},
          cart_shipping_calculator_hide_calculator: {{ 'cart.shipping_calculator.hide_calculator' | t | json }},
          cart_shipping_calculator_title: {{ 'cart.shipping_calculator.title' | t | json }},
          cart_general_hide_note: {{ 'cart.general.hide_note' | t | json }},
          cart_general_show_note: {{ 'cart.general.show_note' | t | json }},
          previous: {{'general.accessibility_labels.previous' | t | json }},
          next: {{'general.accessibility_labels.next' | t | json }},
          cartShippingMessage: {{ 'cart.general.drawer_add_for_free_shipping' | t | json }},
          cartFreeShippingMessage: {{ 'cart.general.drawer_qualify_free_shipping' | t | json }},
          onlyXLeftInStock: {{ 'products.labels.only_x_left_in_stock' | t: count: '[[ count ]]' | json }}
        };
        theme.cartDrawerShippingThreshold = {{ settings.free_shipping_threshold | default: 0 | times: 100 }};
        theme.routes = {
          account_login_url: '{{ routes.account_login_url }}',
          account_register_url: '{{ routes.account_register_url }}',
          account_addresses_url: '{{ routes.account_addresses_url }}',
          search_url: '{{ routes.search_url }}',
          cart_url: '{{ routes.cart_url }}',
          cart_add_url: '{{ routes.cart_add_url }}',
          cart_change_url: '{{ routes.cart_change_url }}',
          product_recommendations_url: '{{ routes.product_recommendations_url }}'
        };
        theme.settings = {
          dynamicQtyOpts: {{ settings.hide_unavailable_quantity_opts | json }},
          saleLabelEnabled: {{ settings.sale_label_enabled | json }},
          soldLabelEnabled: {{ settings.sold_label_enabled | json }}
        };
      </script>

      <script src="{{ 'shop-the-look-card.js' | asset_url }}" defer="defer"></script>
        <script src="{{ 'bulk-add-to-cart.js' | asset_url }}" defer="defer"></script>
        {{ 'product-block-quick-add.css' | asset_url | stylesheet_tag }}
  
      {%- if template.directory == 'customers' -%}
        <script src="{{ 'shopify_common.js' | shopify_asset_url }}" defer="defer"></script>
      {%- endif -%}
  
      {%- if (settings.swatch_enabled_productpage or settings.swatch_enabled_grid) and settings.swatch_value_list != blank -%}
        <style>
          {%- assign swatch_lines = settings.swatch_value_list | newline_to_br | strip_newlines | split: '<br />' -%}
          {%- for line in swatch_lines -%}
            {%- assign line_split = line | split: ':' -%}
            {%- assign swatch_raw = line_split.first | downcase | replace: '"', '' -%}
            {%- assign swatch_handle = swatch_raw | handleize -%}
            {%- if line_split.last contains '#' -%}
              [data-swatch="{{ swatch_raw }}"],[data-swatch="{{ swatch_handle }}"] { --swatch-background-color: {{- line_split.last -}} } {%- else -%} [data-swatch="{{ swatch_raw }}"],[data-swatch="{{ swatch_handle }}"] { --swatch-background-image: url({{- line_split.last | strip | file_img_url: '128x128', crop: settings.swatch_crop_align -}}) } {%- endif -%} {%- endfor -%}</style>
          {%- endif -%}
        {{ content_for_header }}
  
          <!-- GSSTART Coming Soon code start. Do not change -->
          <script type="text/javascript">
            gsProductByVariant = {};
            {% if product.id > 1 %}
              {% for variant in product.variants %}
                gsProductByVariant[{{ variant.id }}] =
                {% if variant.available %}
                  1
                {% else %}
                  0
                {% endif %};
              {% endfor %}
            {% endif %}
            gsProductCSID = "{{ product.id }}"; gsDefaultV = "{{ product.selected_or_first_available_variant.id }}";
          </script>
          <script type="text/javascript" src="https://gravity-software.com/js/shopify/pac_shop18139.js?v=f14654579cc4de73b8a4faeffe703717"></script>
  
          <meta name="google-site-verification" content="2TOx9vhpxHsvd8Omnq6LlbC54mAriL9s2OqWAEeeMZk">
          <meta name="facebook-domain-verification" content="rmo4t7irp3olf9axbsq8ql282debh2">
  
          <!-- DEPARTMENT -->
          {% assign dep = 'bloch-dance' %}
    {% render 'GTM-product-datalayer.liquid' %}
          {% include 'analyzify-gtm-body' %}
        {% include 'pagefly-app-header' %}</head>
        <body id="{{ page_title | handle }}" class="dep-{{ dep }} template-{{ template | split: '.' | first }}
                                              {%- if template.suffix %} template-suffix-{{ template.suffix }}{% endif -%}
                                              {%- if settings.swatch_enabled_productpage %} swatch-method-{{ settings.swatch_method }}{% endif -%}">
         
          <a class="in-page-link visually-hidden skip-link" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>
          
          {% section 'global-header' %}
          {% section 'header' %}
  
          {%- if template.name contains 'product' %}
            <div class="container breadcrumbs-container">
              <div class="page-width">
                {% render 'breadcrumbs', show_next_prev: true %}
              </div>
            </div>
          {%- endif -%}
  
  
          <main id="MainContent">
            {%- assign accent_alpha = settings.accent_color | color_extract: 'alpha' -%}
            {%- if template contains 'index' -%}
              {%- if settings.color_body_background != settings.accent_color and accent_alpha > 0 -%}
                <span class="accent-background"></span>
              {%- endif -%}
              {% section 'banner' %}
            {%- endif -%}

            {% comment %}
              Global breadcrumbs: show on all templates except
              - index (homepage)
              - cart
              - list-collections
              - password
              - blog
              - articlepages
              - the custom blog landing page template (pf-429eb794)
            {% endcomment %}
            {% if template.name != 'index'
              and template.name != 'cart'
              and template.name != 'list-collections'
              and template.name != 'password'
              and template.name != 'blog'
              and template.name != 'article'
              and template.suffix != 'pf-429eb794' %}

              <div class="page-width">
                <div class="breadcrumbs-container">
                  {% render 'breadcrumbs', show_next_prev: template.name == 'product' %}
                </div>
              </div>

            {% endif %}


            {{ content_for_layout }}
          </main>
  
  
          {% section 'footer' %}
  
          {% section 'popup' %}
  
          <a
            href="#"
            class="focus-tint"
            aria-hidden="true"
            aria-label="{{ 'general.accessibility_labels.close' | t }}"></a>
  
          {%- if template contains 'product' -%}
            {% render 'photoswipe' %}
          {%- endif -%}
  
          <script src="{{ 'vendor.min.js' | asset_url }}" defer="defer"></script>
          <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
          <script src="{{ 'utils.js' | asset_url }}" defer="defer"></script>
          <script src="{{ 'dialog.js' | asset_url }}" defer="defer"></script>
          <script src="{{ 'tabs-manual.js' | asset_url }}" defer="defer"></script>
  
          {% include 'swymSnippet' %}
          {% render 'special-offers' %}
  
          <div class="index-section--flush powr-popup" id="e78ffe3a_1617018036"></div>
