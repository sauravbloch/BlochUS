<div
  class="b-rewards b-rewards__section b-rewards__faq-v2"
  style="background: {{ section.settings.bg }};"
>
  <div class="page-width">

    <div class="b-rewards__center b-rewards__faq-v2-header">
      {% if section.settings.eyebrow != blank %}
        <p class="b-rewards__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="large-title b-rewards__title b-rewards__faq-v2-heading">
          {{ section.settings.heading | escape }}
        </h2>
      {% endif %}

      {% if section.settings.intro != blank %}
        <div class="rte b-rewards__intro b-rewards__faq-v2-intro">
          {{ section.settings.intro }}
        </div>
      {% endif %}
    </div>

    <div class="b-rewards__faq-v2-content">
      {% assign category_count = 0 %}

      {% for block in section.blocks %}
        {% if block.type == 'category' %}
          {% unless forloop.first %}
            {% if category_count > 0 %}
                </div>
              </section>
            {% endif %}
          {% endunless %}

          {% assign category_count = category_count | plus: 1 %}

          <section
            class="b-rewards__faq-category"
            {{ block.shopify_attributes }}
          >
            <div class="b-rewards__faq-category-header">
              <p class="b-rewards__faq-category-number">
                0{{ category_count }}
              </p>

              <div class="b-rewards__faq-category-copy">
                <h3 class="b-rewards__faq-category-title">
                  {{ block.settings.heading | escape }}
                </h3>

                {% if block.settings.intro != blank %}
                  <div class="rte b-rewards__faq-category-intro">
                    {{ block.settings.intro }}
                  </div>
                {% endif %}
              </div>
            </div>

            <div class="b-rewards__faq-category-items">

        {% elsif block.type == 'question' %}
          <article
            class="b-rewards__faq-v2-item"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.question != blank %}
              <h4 class="b-rewards__faq-v2-question">
                {{ block.settings.question | escape }}
              </h4>
            {% endif %}

            {% if block.settings.answer != blank %}
              <div class="rte b-rewards__faq-v2-answer">
                {{ block.settings.answer }}
              </div>
            {% endif %}
          </article>
        {% endif %}
      {% endfor %}

      {% if category_count > 0 %}
          </div>
        </section>
      {% endif %}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "B-Rewards FAQ v2",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "NEED TO KNOW"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "B-Rewards FAQs"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Find answers to the most common questions about earning points, moving through tiers and redeeming your rewards.</p>"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category heading",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Category name",
          "default": "Getting Started"
        },
        {
          "type": "richtext",
          "id": "intro",
          "label": "Category intro",
          "default": "<p>Everything you need to know before you begin.</p>"
        }
      ]
    },
    {
      "type": "question",
      "name": "Question and answer",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is B-Rewards?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>B-Rewards is Bloch's loyalty program, designed to reward members as they shop.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
