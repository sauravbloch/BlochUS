{{ 'b-rewards-relaunch.css' | asset_url | stylesheet_tag }}
<div class="b-rewards b-rewards__hero" style="--br-overlay:{{ section.settings.overlay | divided_by: 100.0 }};--br-hero-text:{{ section.settings.text_color }};">
  <div class="b-rewards__hero-media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '750,1100,1500,2000,2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high' }}
    {% endif %}
  </div>
  <div class="b-rewards__hero-content">
    <div class="page-width">
      <div class="b-rewards__hero-copy b-rewards__hero-copy--{{ section.settings.alignment }}">
        {% if section.settings.eyebrow != blank %}<p class="b-rewards__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        <h1 class="b-rewards__hero-title">{{ section.settings.heading | escape }}</h1>
        {% if section.settings.text != blank %}<div class="b-rewards__hero-text rte">{{ section.settings.text }}</div>{% endif %}
        <div class="b-rewards__buttons">
          {% if section.settings.primary_label != blank %}<a class="btn btn--primary" href="{{ section.settings.primary_link | default: routes.account_register_url }}">{{ section.settings.primary_label | escape }}</a>{% endif %}
          {% if section.settings.secondary_label != blank %}<a class="btn btn--secondary" href="{{ section.settings.secondary_link | default: routes.account_login_url }}">{{ section.settings.secondary_label | escape }}</a>{% endif %}
        </div>
      </div>
    </div>
  </div>
</div>
{% schema %}
{"name":"B-Rewards hero","tag":"section","settings":[{"type":"image_picker","id":"image","label":"Background image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"B-REWARDS"},{"type":"text","id":"heading","label":"Heading","default":"More rewards. More reasons to move."},{"type":"richtext","id":"text","label":"Text","default":"<p>Join our refreshed loyalty program and earn points every time you shop.</p>"},{"type":"select","id":"alignment","label":"Text alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"center"},{"type":"range","id":"overlay","label":"Image overlay","min":0,"max":80,"step":5,"unit":"%","default":25},{"type":"color","id":"text_color","label":"Text color","default":"#ffffff"},{"type":"text","id":"primary_label","label":"Primary button","default":"Join B-Rewards"},{"type":"url","id":"primary_link","label":"Primary link"},{"type":"text","id":"secondary_label","label":"Secondary button","default":"Sign in"},{"type":"url","id":"secondary_link","label":"Secondary link"}],"presets":[{"name":"B-Rewards hero"}]}
{% endschema %}
