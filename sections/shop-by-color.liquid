{%- liquid
  assign col_count = section.blocks.size
  if col_count < 3
    assign col_count = 3
  endif
  if col_count > 6
    assign col_count = 6
  endif

  case col_count
    when 3
      assign col_class = 'one-third'
    when 4
      assign col_class = 'one-quarter'
    when 5
      assign col_class = 'one-fifth'
    when 6
      assign col_class = 'one-sixth'
    else
      assign col_class = 'one-third'
  endcase
-%}

{% style %}
  #shopify-section-{{ section.id }} .shop-the-color__item.one-fifth {
    width: 20%;
  }

  #shopify-section-{{ section.id }} .shop-the-color__image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .shop-the-color__image-wrap img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .shop-the-color__image-wrap .placeholder-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .shop-the-color__text {
    position: absolute;
    left: 7px;
    right: 0;
    bottom: 7px;
    z-index: 2;
    padding: 13px 14px 13px;
  }

  #shopify-section-{{ section.id }} .shop-the-color__heading {
    font-size: 0.95em;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin: 0 0 8px;
    line-height:inherit;
  }

  #shopify-section-{{ section.id }} .shop-the-color__description {
    font-size: 0.85em;
    line-height: 1.4;
    margin: 0 0 10px;
    margin:0;
  }

  #shopify-section-{{ section.id }} .grid .shop-the-color__item.grid__item {
    padding-left:15px;
    margin-bottom: 15px;
  }

 
  #shopify-section-{{ section.id }} .shop-the-color__description p {
    margin:0;
  }

  #shopify-section-{{ section.id }} .shop-the-color__cta {
    font-size: 0.8em;
    text-decoration: underline;
    display: inline-block;
  }

   #shopify-section-{{ section.id }} .shop-the-color__section-heading {
        font-family: Aime;
    font-size: 32px;
    /* padding-bottom: 0; */
    /* margin-top: 0; */
    padding-left: 10px;
    margin-bottom: 10px;
  }

  #shopify-section-{{ section.id }} .shop-the-color__heading,
  #shopify-section-{{ section.id }} .shop-the-color__description,
  #shopify-section-{{ section.id }} .shop-the-color__cta {
    color: inherit;
  }
{% endstyle %}

<div class="container shop-the-color" data-section-id="{{ section.id }}" data-section-type="shop-the-color">
  <div class="page-width">

    {%- if section.settings.heading != blank -%}
      <h2 class="shop-the-color__section-heading title">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="grid shop-the-color__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign auto_text_color = '#0e0e0e'
            if block.settings.text_bg_color != blank
              assign bg_hex = block.settings.text_bg_color | remove_first: '#' | downcase
              assign hex_chars = '0123456789abcdef' | split: ''

              assign r_hi = hex_chars | index_of: bg_hex[0]
              assign r_lo = hex_chars | index_of: bg_hex[1]
              assign g_hi = hex_chars | index_of: bg_hex[2]
              assign g_lo = hex_chars | index_of: bg_hex[3]
              assign b_hi = hex_chars | index_of: bg_hex[4]
              assign b_lo = hex_chars | index_of: bg_hex[5]

              assign r_val = r_hi | times: 16 | plus: r_lo
              assign g_val = g_hi | times: 16 | plus: g_lo
              assign b_val = b_hi | times: 16 | plus: b_lo

              assign r_weighted = r_val | times: 299
              assign g_weighted = g_val | times: 587
              assign b_weighted = b_val | times: 114
              assign brightness_sum = r_weighted | plus: g_weighted | plus: b_weighted

              if brightness_sum < 140000
                assign auto_text_color = '#ffffff'
              else
                assign auto_text_color = '#0e0e0e'
              endif
            endif

            assign final_text_color = auto_text_color
            if block.settings.text_color != blank
              assign final_text_color = block.settings.text_color
            endif
          -%}
          <div class="shop-the-color__item grid__item small-down--one-whole {{ col_class }}" {{ block.shopify_attributes }}>

            <div class="shop-the-color__image-wrap global-border-radius">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 800 }} 800w, {{ block.settings.image | image_url: width: 1200 }} 1200w"
                  sizes="(min-width: 1000px) 25vw, 50vw"
                  alt="{{ block.settings.image.alt | escape }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}">
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}

              <div class="shop-the-color__text" style="background-color: {{ block.settings.text_bg_color }}; color: {{ final_text_color }};">
                {%- if block.settings.heading != blank -%}
                  <h3 class="shop-the-color__heading">{{ block.settings.heading | escape }}</h3>
                {%- endif -%}

                {%- if block.settings.description != blank -%}
                  <div class="shop-the-color__description rte">
                    {{ block.settings.description }}
                  </div>
                {%- endif -%}

                {%- if block.settings.cta_text != blank -%}
                  {%- if block.settings.collection != blank -%}
                    {%- assign cta_url = collections[block.settings.collection].url -%}
                  {%- else -%}
                    {%- assign cta_url = '#' -%}
                  {%- endif -%}
                  <a href="{{ cta_url }}" class="shop-the-color__cta">
                    {{- block.settings.cta_text | escape -}}
                  </a>
                {%- endif -%}
              </div>
            </div>

          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Shop the color",
  "class": "section-shop-the-color",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by color"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Recommended aspect ratio 2:3"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Color name"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Text",
          "default": "<p>Describe this color or style.</p>"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "CTA text",
          "default": "Shop now"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "CTA link (collection)"
        },
        {
          "type": "color",
          "id": "text_bg_color",
          "label": "Text background color",
          "default": "#f4f4f4"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "info": "Controls the heading, text, and CTA color. Leave blank to automatically choose based on the background color."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Shop the color",
      "blocks": [
        { "type": "column" },
        { "type": "column" },
        { "type": "column" }
      ]
    }
  ]
}
{% endschema %}
