<style>
  .desktop-only{ display: none; }
  @media only screen and (min-width: 481px) { 
    .desktop-only{ display: block; }
  }
</style>
<div class="desktop-only">
<div class="container container--no-mobile-padding large-row full-width-slideshow full-width-background relative section-{{ section.id }}" data-section-id="{{ section.id }}" data-section-type="slideshow">
  
  {% style %}
  {%- if section.settings.height == 'fixed' -%}
    .section-{{ section.id }} .rimage-outer-wrapper,
    .section-{{ section.id }} .placeholder-container {
      height: {{ section.settings.height_mobile }}px;
    }
    @media (min-width: 768px) {
      .section-{{ section.id }} .rimage-outer-wrapper,
      .section-{{ section.id }} .placeholder-container {
        height: {{ section.settings.height_desktop }}px;
      }
    }
  {%- endif -%}
    {% for block in section.blocks %}
      .section-{{ section.id }} .block-{{ forloop.index }} .overlay {
        top: {{ block.settings.overlay_position_y }}%;
        left: {{ block.settings.overlay_position_x }}%;
		text-align: {{ block.settings.overlay_alignment }};
      }
    {% endfor %}
  
  
      .section-{{ section.id }} .overlay {
        top: {{ section.settings.overlay_position_y }}%;
        left: {{ section.settings.overlay_position_x }}%;
		text-align: {{ section.settings.overlay_alignment }};
      } 
  
  {% endstyle %}

  <div class="{% if section.settings.fullwidth != true %}page-width{%- else -%}full-width{% endif %} relative">
    
    
    
    
    {% render 'image-overlay-v3',
              background_color: section.settings.color_overlay_bg,
              background_opacity: section.settings.overlay_opacity,
          	  heading_color: section.settings.color_overlay_heading,
              text_color: section.settings.color_overlay_text,
              title: section.settings.overlay_title,
              enlarge_title: section.settings.enlarge_title,
              text: section.settings.overlay_text,
              enlarge_text: section.settings.enlarge_text,
              url: section.settings.overlay_url_1,
              url_text: section.settings.overlay_url_text_1,
          	  url_img1: section.settings.icon1,
              url_2: section.settings.overlay_url_2,
              url_text_2: section.settings.overlay_url_text_2,
          	  url_img2: section.settings.icon2,   
              url_style: section.settings.overlay_url_style,
              mobile_text_below: false,
              extra_large_text: true %}
    
    
    
    
    
    <div class="full-width relative js-slideshow-section" data-autoplay="{{ section.settings.slideshow_autoplay }}" data-autoplayspeed="{{ section.settings.slideshow_autoplay_speed }}000">
      {% for block in section.blocks %}
        {%- if section.settings.height == 'adapt' -%}
          {%- assign aspect_ratio = section.blocks.first.settings.image.aspect_ratio | default: 2.2 -%}
        {%- else -%}
          {%- assign aspect_ratio = block.settings.image.aspect_ratio -%}
        {%- endif -%}
        <div class="slide relative avoid-overlaps block-{{ forloop.index }}" {{ block.shopify_attributes }}>
          <div class="avoid-overlaps__mobile-container">
            {% if block.settings.image_link != blank %}<a href="{{ block.settings.image_link }}">{% endif %}
            

              {% if block.settings.image == blank %}
                {% capture placeholder_name %}lifestyle-{{ forloop.index | modulo: 2 | plus: 1 }}{% endcapture %}
                <div class="placeholder-container relative" {%- if section.settings.height == 'adapt' -%} style="padding-top:{{ 1 | divided_by: aspect_ratio | times: 100 }}%;"{%- endif -%}>
                  {{ placeholder_name | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {% else %}
                <div class="rimage-outer-wrapper rimage-background lazyload fade-in"
                  data-bgset="{% render 'bgset', image: block.settings.image %}"
                  data-sizes="auto"
                  data-parent-fit="cover"
                  style="background-position: {{ block.settings.image_position }}">
                  <div class="rimage-wrapper" style="padding-top:{{ 1 | divided_by: aspect_ratio | times: 100 }}%">
                    <noscript>
                      <img src="{{ block.settings.image | img_url: '375x675' }}" alt="{{ block.settings.image.alt | escape }}" class="rimage__image">
                    </noscript>
                  </div>
                </div>
              {% endif %}                                  
            {% if block.settings.image_link != blank %}</a>{% endif %}
          </div>     
          
          
        </div>
      {% endfor %}
    </div>   
    
    
    {% if section.blocks.size > 1 %}
      <div class="full-width-slideshow-controls full-width-slideshow-controls--prev js">
        <button class="btn--plain prev icon feather-icon" aria-label="{{ 'general.accessibility_labels.previous' | t | escape }}">{% render 'feather-arrow-left' %}</button>
      </div>
      <div class="full-width-slideshow-controls full-width-slideshow-controls--next js">
        <button class="btn--plain next icon feather-icon" aria-label="{{ 'general.accessibility_labels.next' | t | escape }}">{% render 'feather-arrow-right' %}</button>
      </div>
    {% endif %}
  </div>
</div>
</div>

{% schema %}
  {
    "name": "Slideshow Desktop",
    "tag": "section",
    "max_blocks": 10,
    "settings": [
      {
        "type": "radio",
        "id": "height",
        "label": "Image height",
        "options": [
          {
            "value": "adapt",
            "label": "Adapt to first image"
          },
          {
            "value": "fixed",
            "label": "Fixed height"
          }
        ],
        "default": "adapt"
      },
      {
        "type": "range",
        "id": "height_desktop",
        "min": 200,
        "max": 1000,
        "step": 20,
        "unit": "px",
        "label": "Desktop fixed height",
        "default": 600
      },
      {
        "type": "checkbox",
        "id": "slideshow_autoplay",
        "label": "Auto rotate between slides",
        "default": true
      },
      {
        "type": "range",
        "id": "slideshow_autoplay_speed",
        "label": "Change slides every",
        "min": 4,
        "max": 10,
        "unit": "s",
        "step": 1,
        "default": 6
      },
      {
        "type": "checkbox",
        "id": "fullwidth",
        "label": "Full width slideshow",
        "default": true
      },
 		  {
            "type": "header",
            "content": "Overlay"
          },
          {
            "type": "color",
            "id": "color_overlay_bg",
            "label": "Background color",
            "default": "#ffffff"
          },
          {
            "type": "range",
            "id": "overlay_opacity",
            "min": 0,
            "max": 100,
            "step": 1,
            "label": "Background opacity",
            "default": 80,
            "unit": "%",
            "info": "Applies to box around text"
          },
          {
            "type": "color",
            "id": "color_overlay_heading",
            "label": "Heading color",
            "default": "#4C4545"
          },
          {
            "type": "color",
            "id": "color_overlay_text",
            "label": "Text color",
            "default": "#4C4545"
          },
          {
            "type": "textarea",
            "id": "overlay_title",
            "label": "Heading",
            "default": "Slideshow Desktop"
          },
          {
            "type": "text",
            "id": "overlay_text",
            "label": "Text",
            "default": "Use this section to welcome customers to your store, show off your images or display a promotion"
          },
 		  {
            "type": "header",
            "content": "Button 1"
          },
          {
            "type": "text",
            "id": "overlay_url_text_1",
            "label": "Button 1 text"
          },
          {
            "type": "image_picker",
            "id": "icon1",
            "label": "Icon 1",
            "info": "80 x 80px recommended"
          },
          {
            "type": "url",
            "id": "overlay_url_1",
            "label": "Button 1 link"
          },
          {
            "type": "radio",
            "id": "overlay_url_style",
            "label": "Button style",
            "options": [
              { "value": "button_1", "label": "Button - primary" },
              { "value": "button_2", "label": "Button - secondary" }
            ],
            "default": "button_1"
          },
 		  {
            "type": "header",
            "content": "Button 2"
          },
          {
            "type": "text",
            "id": "overlay_url_text_2",
            "label": "Button 2 text"
          },
          {
            "type": "image_picker",
            "id": "icon2",
            "label": "Icon 2",
            "info": "80 x 80px recommended"
          },
          {
            "type": "url",
            "id": "overlay_url_2",
            "label": "Button 2 link"
          },
          {
            "type": "checkbox",
            "id": "enlarge_title",
            "label": "Enlarge heading",
            "default": false
          },
          {
            "type": "checkbox",
            "id": "enlarge_text",
            "label": "Enlarge text",
            "default": false
          },
          {
            "type": "select",
            "id": "overlay_alignment",
            "label": "Text alignment",
            "options": [
              {
                "value": "left",
                "label": "Left"
              },
              {
                "value": "center",
                "label": "Center"
              },
              {
                "value": "right",
                "label": "Right"
              }
            ],
            "default": "center"
          },
          {
            "type": "range",
            "id": "overlay_position_x",
            "label": "Horizontal position",
            "min": 0,
            "max": 100,
            "unit": "%",
            "step": 5,
            "default": 50
          },
          {
            "type": "range",
            "id": "overlay_position_y",
            "label": "Vertical position",
            "min": 0,
            "max": 100,
            "unit": "%",
            "step": 5,
            "default": 80
          }
    ],
    "blocks": [
      {
        "type": "image",
        "name": "Slide",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image",
            "info": "2048 x 1024px recommended"
          },
          {
            "type": "select",
            "id": "image_position",
            "label": "Image alignment",
            "info": "Used to keep the subject of your image in view",
            "default": "center center",
            "options": [
              {
                "value": "top left",
                "label": "Top left"
              },
              {
                "value": "top center",
                "label": "Top center"
              },
              {
                "value": "top right",
                "label": "Top right"
              },
              {
                "value": "center left",
                "label": "Middle left"
              },
              {
                "value": "center center",
                "label": "Middle center"
              },
              {
                "value": "center right",
                "label": "Middle right"
              },
              {
                "value": "bottom left",
                "label": "Bottom left"
              },
              {
                "value": "bottom center",
                "label": "Bottom center"
              },
              {
                "value": "bottom right",
                "label": "Bottom right"
              }
            ]
          },
          {
            "type": "url",
            "id": "image_link",
            "label": "Image link"
          }
        ]
      }
    ],
    "templates": [
      "404",
      "article",
      "blog",
      "cart",
      "collection",
      "index",
      "list-collections",
      "page",
      "product",
      "search"
    ],
    "presets": [
      {
        "name": "Slideshow Desktop",
        "blocks": [
          {
            "type": "image"
          },
          {
            "type": "image"
          }
        ]
      }
    ]
  }
{% endschema %}
