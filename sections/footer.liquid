          }
        ]
      },
      {
        "type": "social",
        "name": "Social links",
        "settings": [
          {
            "type": "text",
            "id": "heading",
            "label": "Follow us"
          },
          {
            "type": "header",
            "content": "Accounts"
          },
          {
            "type": "text",
            "id": "social_twitter_url",
            "label": "Twitter",
            "info": "https:\/\/twitter.com\/shopify"
          },
          {
            "type": "text",
            "id": "social_facebook_url",
