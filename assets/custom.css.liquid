/* Alo-style disabled swatch: grid wrap + diagonal line (consistent on all colours) */
.product-block-group__swatch-wrap {
  position: relative;
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  padding: 4px 0 4px 1px;
}

.product-block-group__swatch-wrap .swatch-disabled-ui {
  display: none;
  position: absolute;
  width: 85%;
  height: 2px;
  left: 50%;
  top: 50%;
  /* theme has no --white; matches reference pattern */
  background: #fff;
  transform-origin: 0 -15%;
  transform: rotate(45deg) translate(-50%, -50%);
  pointer-events: none;
  z-index: 1;
}

.product-block-group__swatch-wrap .swatch-disabled-ui .line {
  display: block;
  width: 100%;
  height: 100%;
}

.product-block-group__swatch-wrap:has(.product-block-group__swatch--disabled) .swatch-disabled-ui {
  display: block;
}

/* OOS swatches stay visually marked but remain clickable (pointer, not inert) */
.product-block-group__swatch-wrap:has(.product-block-group__swatch--disabled) .product-block-group__swatch {
  cursor: pointer;
}

.product-block-group__swatches .color-swatch-link {
  min-width: auto;
  height: 24px;
  width: 24px;
  box-shadow: none;
}

.product-block-group__swatches .color-swatch-link-current {
  padding: 2px;
  border: 1px solid black;
}

.product-block-group__swatches .related-swatch-img {
  height: 24px;
  width: 24px;
  margin: 0;
  display: block;
  border-radius: 50%;
}

.product-block-group__swatches .swatch-sample {
  margin: 0;
}

.product-block-group__swatches .color-swatch-link .related-swatch-img {
  height: 100%;
  width: 100%;
}

.product-block-group__swatches .product-block-group__swatch-more {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-left: 5px;
  font-size: 14px;
  line-height: 1;
  color: #000;
  border: 1px solid transparent;
  text-decoration: none;
}

.product-block-group__swatch[hidden],
.product-block-group__swatch-more[hidden] {
  display: none !important;
}

#colorbox .quickbuy__group-swatches {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
  margin: 8px 0 12px;
}

#colorbox .quickbuy__group-swatches .product-block-group__swatch {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* PLP + Quick Buy grouped swatches: disable token CSS fallback from swatches.css
   when no inline metafield style is present on the swatch dot. */
.product-block-group__swatches .product-block-group__swatch[data-swatch] .swatch-sample:not([style]),
#colorbox .quickbuy__group-swatches .product-block-group__swatch[data-swatch] .swatch-sample:not([style]) {
