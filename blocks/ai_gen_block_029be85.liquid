{% doc %}
  @prompt
    create image with text block with 10 padding, create 2 image with text in the same block, allow text to change alignment
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-double-image-text-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 10px;
  }

  .ai-double-image-text-wrapper-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.gap }}px;
  }

  .ai-double-image-text-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: {{ block.settings.layout }};
    gap: {{ block.settings.item_gap }}px;
    align-items: center;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.content_padding }}px;
  }

  .ai-double-image-text-image-wrapper-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
  }

  .ai-double-image-text-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-double-image-text-placeholder-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-double-image-text-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .ai-double-image-text-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-double-image-text-content-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-double-image-text-heading-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
  }

  .ai-double-image-text-text-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.text_spacing }}px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
  }

  .ai-double-image-text-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    transition: background-color 0.3s ease;
  }

  .ai-double-image-text-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  @media screen and (max-width: 749px) {
    .ai-double-image-text-wrapper-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-double-image-text-item-{{ ai_gen_id }} {
      flex-direction: column;
    }
  }
{% endstyle %}

<ai-double-image-text-{{ ai_gen_id }} class="ai-double-image-text-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-double-image-text-wrapper-{{ ai_gen_id }}">
    <div class="ai-double-image-text-item-{{ ai_gen_id }}">
      <div class="ai-double-image-text-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image_1 %}
          <img
            src="{{ block.settings.image_1 | image_url: width: 1200 }}"
            alt="{{ block.settings.image_1.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image_1.width }}"
            height="{{ block.settings.image_1.height }}"
            class="ai-double-image-text-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-double-image-text-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-double-image-text-empty-state-{{ ai_gen_id }}">
              Add image 1
            </div>
          </div>
        {% endif %}
      </div>

      <div class="ai-double-image-text-content-{{ ai_gen_id }}">
        {% if block.settings.heading_1 != blank %}
          <h2 class="ai-double-image-text-heading-{{ ai_gen_id }}">{{ block.settings.heading_1 }}</h2>
        {% endif %}

        {% if block.settings.text_1 != blank %}
          <div class="ai-double-image-text-text-{{ ai_gen_id }}">{{ block.settings.text_1 }}</div>
        {% endif %}

        {% if block.settings.button_text_1 != blank and block.settings.button_link_1 != blank %}
          <a href="{{ block.settings.button_link_1 }}" class="ai-double-image-text-button-{{ ai_gen_id }}">
            {{ block.settings.button_text_1 }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="ai-double-image-text-item-{{ ai_gen_id }}">
      <div class="ai-double-image-text-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image_2 %}
          <img
            src="{{ block.settings.image_2 | image_url: width: 1200 }}"
            alt="{{ block.settings.image_2.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image_2.width }}"
            height="{{ block.settings.image_2.height }}"
            class="ai-double-image-text-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-double-image-text-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-double-image-text-empty-state-{{ ai_gen_id }}">
              Add image 2
            </div>
          </div>
        {% endif %}
      </div>

      <div class="ai-double-image-text-content-{{ ai_gen_id }}">
        {% if block.settings.heading_2 != blank %}
          <h2 class="ai-double-image-text-heading-{{ ai_gen_id }}">{{ block.settings.heading_2 }}</h2>
        {% endif %}

        {% if block.settings.text_2 != blank %}
          <div class="ai-double-image-text-text-{{ ai_gen_id }}">{{ block.settings.text_2 }}</div>
        {% endif %}

        {% if block.settings.button_text_2 != blank and block.settings.button_link_2 != blank %}
          <a href="{{ block.settings.button_link_2 }}" class="ai-double-image-text-button-{{ ai_gen_id }}">
            {{ block.settings.button_text_2 }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</ai-double-image-text-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Double image with text",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position",
      "options": [
        {
          "value": "column",
          "label": "Top"
        },
        {
          "value": "row",
          "label": "Left"
        },
        {
          "value": "row-reverse",
          "label": "Right"
        }
      ],
      "default": "column"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between items",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Space between image and text",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Content padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Item 1"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading_1",
      "label": "Heading",
      "default": "Image with text 1"
    },
    {
      "type": "richtext",
      "id": "text_1",
      "label": "Text",
      "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post.</p>"
    },
    {
      "type": "text",
      "id": "button_text_1",
      "label": "Button text",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Item 2"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "Heading",
      "default": "Image with text 2"
    },
    {
      "type": "richtext",
      "id": "text_2",
      "label": "Text",
      "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post.</p>"
    },
    {
      "type": "text",
      "id": "button_text_2",
      "label": "Button text",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Typography"
