{% doc %}
  @prompt
    can you create me a mulitcolumn block that has a html code heading and space for 3 images with heading, subheading and CTA link below, can you make them CTA links instead of buttons, make text left aligned and the heading bold
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-multicolumn-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-multicolumn-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-multicolumn-heading-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-multicolumn-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-multicolumn-item-{{ ai_gen_id }} {
    text-align: left;
  }

  .ai-multicolumn-image-wrapper-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.image_spacing }}px;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-multicolumn-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-multicolumn-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-multicolumn-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-multicolumn-item-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.item_heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.item_heading_spacing }}px;
    font-weight: bold;
  }

  .ai-multicolumn-item-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.item_subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0 0 {{ block.settings.item_subheading_spacing }}px;
    line-height: 1.5;
  }

  .ai-multicolumn-item-link-{{ ai_gen_id }} {
    display: inline-block;
    color: {{ block.settings.cta_text_color }};
    text-decoration: underline;
    font-size: {{ block.settings.cta_font_size }}px;
    transition: color 0.3s ease;
  }

  .ai-multicolumn-item-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.cta_hover_text_color }};
  }

  @media screen and (max-width: 768px) {
    .ai-multicolumn-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.column_gap | times: 1.5 }}px;
    }
  }
{% endstyle %}

<multicolumn-block-{{ ai_gen_id }} class="ai-multicolumn-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-multicolumn-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <div class="ai-multicolumn-heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </div>
    {% endif %}

    <div class="ai-multicolumn-grid-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign heading_key = 'heading_' | append: i
          assign subheading_key = 'subheading_' | append: i
          assign link_key = 'link_' | append: i
          assign link_text_key = 'link_text_' | append: i

          assign image = block.settings[image_key]
          assign heading = block.settings[heading_key]
          assign subheading = block.settings[subheading_key]
          assign link = block.settings[link_key]
          assign link_text = block.settings[link_text_key]
        %}

        <div class="ai-multicolumn-item-{{ ai_gen_id }}">
          <div class="ai-multicolumn-image-wrapper-{{ ai_gen_id }}">
            {% if image %}
              <img
                src="{{ image | image_url: width: 600 }}"
                alt="{{ image.alt | escape }}"
                loading="lazy"
                width="{{ image.width }}"
                height="{{ image.height }}"
                class="ai-multicolumn-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-multicolumn-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          {% if heading != blank %}
            <h3 class="ai-multicolumn-item-heading-{{ ai_gen_id }}">{{ heading }}</h3>
          {% endif %}

          {% if subheading != blank %}
            <div class="ai-multicolumn-item-subheading-{{ ai_gen_id }}">{{ subheading }}</div>
          {% endif %}

          {% if link != blank and link_text != blank %}
            <a href="{{ link }}" class="ai-multicolumn-item-link-{{ ai_gen_id }}">
              {{ link_text }}
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</multicolumn-block-{{ ai_gen_id }}>

