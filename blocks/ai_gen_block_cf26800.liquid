{% doc %}
  @prompt
    can you create me a rich text block that matches the collection title and description as used on the site 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-rich-text-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-rich-text__title-{{ ai_gen_id }} {
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-weight: {{ block.settings.title_font.weight }};
    font-style: {{ block.settings.title_font.style }};
    font-size: {{ block.settings.title_size }}px;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
    {% if block.settings.uppercase_title %}
      text-transform: uppercase;
    {% endif %}
  }

  .ai-rich-text__content-{{ ai_gen_id }} {
    font-family: {{ block.settings.content_font.family }}, {{ block.settings.content_font.fallback_families }};
    font-weight: {{ block.settings.content_font.weight }};
    font-style: {{ block.settings.content_font.style }};
    font-size: {{ block.settings.content_size }}px;
    line-height: 1.4;
    letter-spacing: 0.025em;
    color: {{ block.settings.content_color }};
  }

  .ai-rich-text__content-{{ ai_gen_id }} p {
    margin: 0 0 1em 0;
  }

  .ai-rich-text__content-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-rich-text__content-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
  }

  .ai-rich-text__content-{{ ai_gen_id }} a:hover {
    opacity: 0.8;
  }

  @media screen and (max-width: 749px) {
    .ai-rich-text-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px {{ block.settings.padding_bottom | times: 0.7 }}px;
    }

    .ai-rich-text__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-rich-text__content-{{ ai_gen_id }} {
      font-size: {{ block.settings.content_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-rich-text-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.title != blank %}
    <h2 class="ai-rich-text__title-{{ ai_gen_id }}">
      {{ block.settings.title }}
    </h2>
  {% endif %}

  {% if block.settings.content != blank %}
    <div class="ai-rich-text__content-{{ ai_gen_id }}">
      {{ block.settings.content }}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "Collection title"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Description",
      "default": "<p>Add your collection description here. This rich text block matches the styling of your collection pages.</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Title style"
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "Font",
      "default": "sans-serif"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color",
      "default": "#0e0e0e"
    },
    {
      "type": "checkbox",
      "id": "uppercase_title",
      "label": "Uppercase",
      "default": false
    },
    {
      "type": "range",
      "id": "title_spacing",
      "label": "Spacing below",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Description style"
    },
    {
      "type": "font_picker",
      "id": "content_font",
      "label": "Font",
      "default": "sans-serif"
    },
    {
      "type": "range",
      "id": "content_size",
      "label": "Size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "content_color",
      "label": "Color",
      "default": "#0e0e0e"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#0e0e0e"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Rich text"
    }
  ]
}
{% endschema %}
