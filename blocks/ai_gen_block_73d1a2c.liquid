{% doc %}
  @prompt
    create a multi column section with 10 padding at top and bottom, add a heading with option to change alignment, create 4 wide
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-multi-column-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
  }

  .ai-multi-column-container-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-multi-column-heading-{{ ai_gen_id }} {
    margin: 0 0 30px;
    text-align: {{ block.settings.heading_alignment }};
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-multi-column-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-multi-column-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: {{ block.settings.content_alignment }};
    text-align: {{ block.settings.content_alignment }};
  }

  .ai-multi-column-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: 15px;
  }

  .ai-multi-column-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-multi-column-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-multi-column-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-multi-column-item-heading-{{ ai_gen_id }} {
    margin: 0 0 10px;
    color: {{ block.settings.item_heading_color }};
    font-size: {{ block.settings.item_heading_size }}px;
  }

  .ai-multi-column-item-text-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.item_text_color }};
    font-size: {{ block.settings.item_text_size }}px;
  }

  @media screen and (max-width: 989px) {
    .ai-multi-column-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-multi-column-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }
  }
{% endstyle %}

<multi-column-{{ ai_gen_id }} class="ai-multi-column-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-multi-column-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-multi-column-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-multi-column-grid-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign image_key = 'column_' | append: i | append: '_image'
          assign heading_key = 'column_' | append: i | append: '_heading'
          assign text_key = 'column_' | append: i | append: '_text'
          
          assign column_image = block.settings[image_key]
          assign column_heading = block.settings[heading_key]
          assign column_text = block.settings[text_key]
        %}

        <div class="ai-multi-column-item-{{ ai_gen_id }}">
          <div class="ai-multi-column-image-wrapper-{{ ai_gen_id }}">
            {% if column_image %}
              <img
                src="{{ column_image | image_url: width: 600 }}"
                alt="{{ column_image.alt | escape }}"
                loading="lazy"
                width="{{ column_image.width }}"
                height="{{ column_image.height }}"
                class="ai-multi-column-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-multi-column-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          {% if column_heading != blank %}
            <h3 class="ai-multi-column-item-heading-{{ ai_gen_id }}">{{ column_heading }}</h3>
          {% endif %}

          {% if column_text != blank %}
            <div class="ai-multi-column-item-text-{{ ai_gen_id }}">{{ column_text }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</multi-column-{{ ai_gen_id }}>

<script>
  (function() {
    class MultiColumn{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }
    customElements.define('multi-column-{{ ai_gen_id }}', MultiColumn{{ ai_gen_id }});
  })();
</script>

{% schema %}
