{% doc %}
  @prompt
    replicate this text as live text style over an image as a hero banner block, copy shape of the 'arch angel' title text in this image and add to this block , add the 4 pink dots from the image underneath the title 'arch angel' , reduce the padding between the title and the dots, keep dots and title together, make dots and heading much closer, put the heading and dots in the same area and then subheading underneath, make the dots and heading as close as in this image, make the dots underneath the heading like in the image , set desktop and mobile height of the image, include the dots in the heading section, keep the line of dots in the same formation/shape., allow heading to be more than 60 whilst keeping all text on one line, allow text to be different sizes on dekstop and mobile, increase padding, allow to change 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-banner-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
  }

  .ai-hero-banner-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    height: {{ block.settings.desktop_height }}px;
  }

  .ai-hero-banner-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: {{ block.settings.image_position }};
  }

  .ai-hero-banner-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-hero-banner-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-hero-banner-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-hero-banner-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
    pointer-events: none;
  }

  .ai-hero-banner-content-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: {{ block.settings.text_alignment }};
    width: calc(100% - {{ block.settings.desktop_padding_horizontal | times: 2 }}px);
    max-width: {{ block.settings.content_max_width }}px;
    padding: {{ block.settings.desktop_padding_vertical }}px {{ block.settings.desktop_padding_horizontal }}px;
    z-index: 2;
  }

  .ai-hero-banner-title-group-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0 0 {{ block.settings.spacing_between_elements }}px 0;
  }

  .ai-hero-banner-heading-wrapper-{{ ai_gen_id }} {
    position: relative;
    display: inline-block;
    width: 100%;
    max-width: 100%;
  }

  .ai-hero-banner-heading-{{ ai_gen_id }} {
    margin: 0;
  }

  .ai-hero-banner-heading-{{ ai_gen_id }} svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .ai-hero-banner-heading-{{ ai_gen_id }} text {
    fill: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
    white-space: nowrap;
  }

  .ai-hero-banner-dots-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: {{ block.settings.dot_spacing }}px;
    margin-top: {{ block.settings.heading_dots_gap }}px;
  }

  .ai-hero-banner-dot-{{ ai_gen_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
  }

  .ai-hero-banner-subheading-{{ ai_gen_id }} {
    color: {{ block.settings.subheading_color }};
    font-size: {{ block.settings.subheading_size }}px;
    line-height: 1.4;
    margin: 0 0 {{ block.settings.spacing_between_elements }}px 0;
  }

  .ai-hero-banner-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
    margin: 0 0 {{ block.settings.spacing_between_elements }}px 0;
  }

  .ai-hero-banner-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    transition: background-color 0.3s ease;
  }

  .ai-hero-banner-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-hero-banner-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_height }}px;
    }

    .ai-hero-banner-content-{{ ai_gen_id }} {
      width: calc(100% - {{ block.settings.mobile_padding_horizontal | times: 2 }}px);
      padding: {{ block.settings.mobile_padding_vertical }}px {{ block.settings.mobile_padding_horizontal }}px;
    }

    .ai-hero-banner-heading-{{ ai_gen_id }} text {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-hero-banner-dot-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_dot_size }}px;
      height: {{ block.settings.mobile_dot_size }}px;
    }

    .ai-hero-banner-dots-{{ ai_gen_id }} {
      gap: {{ block.settings.mobile_dot_spacing }}px;
      margin-top: {{ block.settings.mobile_heading_dots_gap }}px;
    }

    .ai-hero-banner-title-group-{{ ai_gen_id }} {
      margin: 0 0 {{ block.settings.mobile_spacing_between_elements }}px 0;
    }

    .ai-hero-banner-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_subheading_size }}px;
      margin: 0 0 {{ block.settings.mobile_spacing_between_elements }}px 0;
    }

    .ai-hero-banner-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_text_size }}px;
      margin: 0 0 {{ block.settings.mobile_spacing_between_elements }}px 0;
    }

    .ai-hero-banner-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_button_text_size }}px;
      padding: {{ block.settings.mobile_button_padding_vertical }}px {{ block.settings.mobile_button_padding_horizontal }}px;
    }
  }
{% endstyle %}

<hero-banner-{{ ai_gen_id }}
  class="ai-hero-banner-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-hero-banner-wrapper-{{ ai_gen_id }}">
    {% if block.settings.image %}
      <img
        src="{{ block.settings.image | image_url: width: 2000 }}"
        alt="{{ block.settings.image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
        class="ai-hero-banner-image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-hero-banner-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <div class="ai-hero-banner-empty-state-{{ ai_gen_id }}">
          Add an image to get started
        </div>
      </div>
    {% endif %}

    {% if block.settings.show_overlay %}
      <div class="ai-hero-banner-overlay-{{ ai_gen_id }}"></div>
    {% endif %}

    <div class="ai-hero-banner-content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <div class="ai-hero-banner-title-group-{{ ai_gen_id }}">
          <div class="ai-hero-banner-heading-wrapper-{{ ai_gen_id }}">
            <h1 class="ai-hero-banner-heading-{{ ai_gen_id }}">
              <svg viewBox="0 0 800 200" preserveAspectRatio="xMidYMid meet">
                <defs>
                  <path
                    id="ai-curve-{{ ai_gen_id }}"
                    d="M 50,120 Q 400,{{ 120 | minus: block.settings.arch_curve_amount }} 750,120"
                    fill="transparent"
                  />
                </defs>
                <text text-anchor="middle">
                  <textPath href="#ai-curve-{{ ai_gen_id }}" startOffset="50%">
                    {{ block.settings.heading }}
                  </textPath>
                </text>
              </svg>
            </h1>
          </div>

          {% if block.settings.show_dots %}
            <div class="ai-hero-banner-dots-{{ ai_gen_id }}">
              <span class="ai-hero-banner-dot-{{ ai_gen_id }}"></span>
              <span class="ai-hero-banner-dot-{{ ai_gen_id }}"></span>
              <span class="ai-hero-banner-dot-{{ ai_gen_id }}"></span>
              <span class="ai-hero-banner-dot-{{ ai_gen_id }}"></span>
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <h2 class="ai-hero-banner-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</h2>
      {% endif %}

      {% if block.settings.text != blank %}
        <div class="ai-hero-banner-text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
      {% endif %}

      {% if block.settings.button_text != blank and block.settings.button_link != blank %}
        <a
          href="{{ block.settings.button_link }}"
          class="ai-hero-banner-button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</hero-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class HeroBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('hero-banner-{{ ai_gen_id }}', HeroBanner{{ ai_gen_id }});
  })();
</script>

