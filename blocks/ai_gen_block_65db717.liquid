{% doc %}
  @prompt
    can you create a column block that will appear as a row of 4 on desktop but will appear as a row of 4 that is able to scroll on mobile, show 2 columns on screen before scroll on mobile, can you give the block a heading and 2 subheading blocks, with the option to have 5 columns but can be hidden, allow for an image in each column, make scrollable between columns on mobile, allow to scroll across all columns on mobile, show scroll bar underneath columns, reduce top padding, allow heading text to change font , ensure each image can be linked to
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-scrollable-row-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.top_padding }}px 0 40px 0;
  }

  .ai-scrollable-row__heading-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 32px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
  }

  .ai-scrollable-row__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-scrollable-row__column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .ai-scrollable-row__column-{{ ai_gen_id }}.hidden {
    display: none;
  }

  .ai-scrollable-row__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: 16px;
  }

  .ai-scrollable-row__image-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-scrollable-row__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-scrollable-row__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-scrollable-row__image-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
  }

  .ai-scrollable-row__subheading-{{ ai_gen_id }} {
    color: {{ block.settings.subheading_color }};
    font-size: {{ block.settings.subheading_size }}px;
    margin-bottom: 8px;
  }

  .ai-scrollable-row__content-{{ ai_gen_id }} {
    color: {{ block.settings.content_color }};
    font-size: {{ block.settings.content_size }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-scrollable-row-{{ ai_gen_id }} {
      padding: {{ block.settings.top_padding }}px 0 40px 0;
    }

    .ai-scrollable-row__container-{{ ai_gen_id }} {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      gap: {{ block.settings.column_gap }}px;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding: 0 20px;
      margin: 0 -20px;
      scrollbar-width: thin;
      scrollbar-color: {{ block.settings.scrollbar_color }} transparent;
    }

    .ai-scrollable-row__container-{{ ai_gen_id }}::-webkit-scrollbar {
      height: 8px;
    }

    .ai-scrollable-row__container-{{ ai_gen_id }}::-webkit-scrollbar-track {
      background: transparent;
      margin: 0 20px;
    }

    .ai-scrollable-row__container-{{ ai_gen_id }}::-webkit-scrollbar-thumb {
      background-color: {{ block.settings.scrollbar_color }};
      border-radius: 4px;
    }

    .ai-scrollable-row__column-{{ ai_gen_id }} {
      flex: 0 0 45%;
      min-width: 45%;
      scroll-snap-align: start;
    }
  }
{% endstyle %}

<scrollable-row-{{ ai_gen_id }} class="ai-scrollable-row-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-scrollable-row__heading-{{ ai_gen_id }}">
      {{ block.settings.heading }}
    </h2>
  {% endif %}

  <div class="ai-scrollable-row__container-{{ ai_gen_id }}">
    {% for i in (1..5) %}
      {% liquid
        assign enabled_key = 'column_' | append: i | append: '_enabled'
        assign image_key = 'column_' | append: i | append: '_image'
        assign link_key = 'column_' | append: i | append: '_link'
        assign subheading_key = 'column_' | append: i | append: '_subheading'
        assign content_key = 'column_' | append: i | append: '_content'
        assign enabled = block.settings[enabled_key]
        assign image = block.settings[image_key]
        assign link = block.settings[link_key]
        assign subheading = block.settings[subheading_key]
        assign content = block.settings[content_key]
      %}
      
      {% if enabled %}
        <div class="ai-scrollable-row__column-{{ ai_gen_id }}">
          <div class="ai-scrollable-row__image-wrapper-{{ ai_gen_id }}">
            {% if link != blank %}
              <a href="{{ link }}" class="ai-scrollable-row__image-link-{{ ai_gen_id }}">
                {% if image %}
                  <img
                    src="{{ image | image_url: width: 600 }}"
                    alt="{{ image.alt | escape }}"
                    loading="lazy"
                    width="{{ image.width }}"
                    height="{{ image.height }}"
                    class="ai-scrollable-row__image-{{ ai_gen_id }}"
                  >
                {% else %}
                  <div class="ai-scrollable-row__image-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </a>
            {% else %}
              {% if image %}
                <img
                  src="{{ image | image_url: width: 600 }}"
                  alt="{{ image.alt | escape }}"
                  loading="lazy"
                  width="{{ image.width }}"
                  height="{{ image.height }}"
                  class="ai-scrollable-row__image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-scrollable-row__image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            {% endif %}
          </div>
          
          {% if subheading != blank %}
            <div class="ai-scrollable-row__subheading-{{ ai_gen_id }}">
              {{ subheading }}
            </div>
          {% endif %}
          
          {% if content != blank %}
            <div class="ai-scrollable-row__content-{{ ai_gen_id }}">
              {{ content }}
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</scrollable-row-{{ ai_gen_id }}>

<script>
  (function() {
    class ScrollableRow{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.container = this.querySelector('.ai-scrollable-row__container-{{ ai_gen_id }}');
      }
    }

    customElements.define('scrollable-row-{{ ai_gen_id }}', ScrollableRow{{ ai_gen_id }});
  })();
</script>

