{% doc %}
  @prompt
    replicate this text as live text style over an image as a hero banner block, copy shape of the 'arch angel' title text in this image and add to this block , add the 4 pink dots from the image underneath the title 'arch angel' , reduce the padding between the title and the dots, keep dots and title together, make dots and heading much closer, put the heading and dots in the same area and then subheading underneath, make the dots and heading as close as in this image, make the dots underneath the heading like in the image , set desktop and mobile height of the image, include the dots in the heading section, keep the line of dots in the same formation/shape., allow heading to be more than 60 whilst keeping all text on one line, allow text to be different sizes on dekstop and mobile, increase padding, allow to change. make the subheading font Times New Roman, heading needs to be curved, allow full heading to be shwon on desktop, make heading bigger on mobile, mobile text needs to be large, it doesn't change with toggle
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    display: block;
  }

  .ai-hero-banner__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .ai-hero-banner__image-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.desktop_height }}px;
    object-fit: cover;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .ai-hero-banner__image-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_height }}px;
    }
  }

  .ai-hero-banner__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.desktop_height }}px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media screen and (max-width: 749px) {
    .ai-hero-banner__image-placeholder-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_height }}px;
    }
  }

  .ai-hero-banner__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-hero-banner__content-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    width: 95%;
    max-width: 100%;
    z-index: 2;
  }

  .ai-hero-banner__heading-wrapper-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: {{ block.settings.dots_spacing }}px;
    margin-bottom: {{ block.settings.content_spacing }}px;
  }

  .ai-hero-banner__heading-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    max-width: 100%;
  }

  .ai-hero-banner__curved-svg-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    overflow: visible;
    display: block;
  }

  .ai-hero-banner__dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: {{ block.settings.dot_spacing }}px;
  }

  .ai-hero-banner__dot-{{ ai_gen_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    background-color: {{ block.settings.dot_color }};
    border-radius: 50%;
  }

  .ai-hero-banner__subheading-{{ ai_gen_id }} {
    margin: 0;
    padding: 0;
    color: {{ block.settings.subheading_color }};
    font-size: {{ block.settings.subheading_size_desktop }}px;
    line-height: 1.4;
    letter-spacing: {{ block.settings.subheading_letter_spacing }}px;
    text-transform: {{ block.settings.subheading_transform }};
    font-weight: {{ block.settings.subheading_weight }};
    font-family: 'Times New Roman', Times, serif;
  }

  @media screen and (max-width: 749px) {
    .ai-hero-banner__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size_mobile }}px;
    }
  }

  .ai-hero-banner__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
    z-index: 1;
  }
{% endstyle %}

<curved-text-{{ ai_gen_id }} class="ai-hero-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-banner__image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.image %}
      <img
        src="{{ block.settings.image | image_url: width: 2000 }}"
        alt="{{ block.settings.image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
        class="ai-hero-banner__image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-hero-banner__image-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}

    {% if block.settings.show_overlay %}
      <div class="ai-hero-banner__overlay-{{ ai_gen_id }}"></div>
    {% endif %}

    <div class="ai-hero-banner__content-{{ ai_gen_id }}">
      <div class="ai-hero-banner__heading-wrapper-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <div class="ai-hero-banner__heading-container-{{ ai_gen_id }}">
            <svg
              class="ai-hero-banner__curved-svg-{{ ai_gen_id }}"
              viewBox="0 0 1000 200"
              xmlns="http://www.w3.org/2000/svg"
              preserveAspectRatio="xMidYMid meet"
              data-desktop-size="{{ block.settings.heading_size_desktop }}"
              data-mobile-size="{{ block.settings.heading_size_mobile }}"
            >
              <defs>
                <path
                  id="curve-{{ ai_gen_id }}"
                  d="M 100,150 Q 500,{{ block.settings.curve_depth }} 900,150"
                  fill="transparent"
                />
              </defs>
              <text
                fill="{{ block.settings.heading_color }}"
                font-size="{{ block.settings.heading_size_desktop }}"
                font-weight="{{ block.settings.heading_weight }}"
                letter-spacing="{{ block.settings.heading_letter_spacing }}"
                text-anchor="middle"
                style="text-transform: {{ block.settings.heading_transform }};"
              >
                <textPath
                  href="#curve-{{ ai_gen_id }}"
                  startOffset="50%"
                >
                  {{ block.settings.heading }}
                </textPath>
              </text>
            </svg>
          </div>
        {% endif %}

        {% if block.settings.show_dots %}
          <div class="ai-hero-banner__dots-{{ ai_gen_id }}">
            <span class="ai-hero-banner__dot-{{ ai_gen_id }}"></span>
            <span class="ai-hero-banner__dot-{{ ai_gen_id }}"></span>
            <span class="ai-hero-banner__dot-{{ ai_gen_id }}"></span>
            <span class="ai-hero-banner__dot-{{ ai_gen_id }}"></span>
          </div>
        {% endif %}
      </div>

      {% if block.settings.subheading != blank %}
        <p class="ai-hero-banner__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
      {% endif %}
    </div>
  </div>
</curved-text-{{ ai_gen_id }}>

<script>
  (function() {
    class CurvedText{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.resizeTimeout = null;
      }

      connectedCallback() {
        this.adjustSVGSize();
        window.addEventListener('resize', () => {
          clearTimeout(this.resizeTimeout);
          this.resizeTimeout = setTimeout(() => this.adjustSVGSize(), 100);
        });
      }

      adjustSVGSize() {
        const svg = this.querySelector('.ai-hero-banner__curved-svg-{{ ai_gen_id }}');
        if (!svg) return;

        const isMobile = window.innerWidth <= 749;
        const desktopSize = svg.getAttribute('data-desktop-size');
        const mobileSize = svg.getAttribute('data-mobile-size');
        const fontSize = isMobile ? mobileSize : desktopSize;
        const text = svg.querySelector('text');
        
        if (text && fontSize) {
          text.setAttribute('font-size', fontSize);
        }
      }

      disconnectedCallback() {
        clearTimeout(this.resizeTimeout);
      }
    }

    customElements.define('curved-text-{{ ai_gen_id }}', CurvedText{{ ai_gen_id }});
  })();
</script>

