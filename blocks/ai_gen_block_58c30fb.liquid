{% doc %}
  @prompt
    a brand blurb with medium logo next to it
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-brand-blurb-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.spacing }}px;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-brand-blurb-logo-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.logo_size }}px;
    height: {{ block.settings.logo_size }}px;
  }

  .ai-brand-blurb-logo-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-brand-blurb-logo-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }

  .ai-brand-blurb-logo-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-brand-blurb-content-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-brand-blurb-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-brand-blurb-{{ ai_gen_id }} {
      flex-direction: {{ block.settings.mobile_layout }};
      text-align: {% if block.settings.mobile_layout == 'column' %}center{% else %}left{% endif %};
    }

    .ai-brand-blurb-logo-{{ ai_gen_id }} {
      width: {{ block.settings.logo_size | times: 0.8 }}px;
      height: {{ block.settings.logo_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-brand-blurb-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-brand-blurb-logo-{{ ai_gen_id }}">
    {% if block.settings.logo %}
      <img
        src="{{ block.settings.logo | image_url: width: 400 }}"
        alt="{{ block.settings.logo.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.logo.width }}"
        height="{{ block.settings.logo.height }}"
      >
    {% else %}
      <div class="ai-brand-blurb-logo-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="ai-brand-blurb-content-{{ ai_gen_id }}">
    {% if block.settings.text != blank %}
      <div class="ai-brand-blurb-text-{{ ai_gen_id }}">
        {{ block.settings.text }}
      </div>
    {% else %}
      <div class="ai-brand-blurb-text-{{ ai_gen_id }}">
        Add your brand story here to connect with your customers.
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Brand blurb",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_size",
      "min": 40,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Logo size",
      "default": 100
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We are a family-owned business dedicated to bringing you the finest products with exceptional service. Our passion for quality and commitment to our customers drives everything we do.</p>"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "spacing",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Spacing between logo and text",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#0e0e0e"
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        {
          "value": "row",
          "label": "Side by side"
        },
        {
          "value": "column",
          "label": "Stacked"
        }
      ],
      "default": "row"
    }
  ],
  "presets": [
    {
      "name": "Brand blurb"
    }
  ]
}
{% endschema %}
