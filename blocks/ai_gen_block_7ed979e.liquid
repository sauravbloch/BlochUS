{% doc %}
  @prompt
    a brand blurb with small logo next to it
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-brand-blurb-{{ ai_gen_id }} {
    display: flex;
    align-items: {{ block.settings.vertical_alignment }};
    gap: {{ block.settings.spacing }}px;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    max-width: 100%;
  }

  .ai-brand-blurb-logo-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.logo_size }}px;
    height: {{ block.settings.logo_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-brand-blurb-logo-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-brand-blurb-logo-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-brand-blurb-logo-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.5;
  }

  .ai-brand-blurb-content-{{ ai_gen_id }} {
    flex-grow: 1;
    min-width: 0;
  }

  .ai-brand-blurb-title-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.title_margin_bottom }}px 0;
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    line-height: 1.2;
  }

  .ai-brand-blurb-text-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.4;
  }

  .ai-brand-blurb-text-{{ ai_gen_id }} p {
    margin: 0 0 1em 0;
  }

  .ai-brand-blurb-text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  {% if block.settings.layout == 'vertical' %}
    .ai-brand-blurb-{{ ai_gen_id }} {
      flex-direction: column;
      text-align: {{ block.settings.text_alignment }};
    }

    .ai-brand-blurb-logo-{{ ai_gen_id }} {
      align-self: {{ block.settings.logo_alignment }};
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    .ai-brand-blurb-{{ ai_gen_id }} {
      {% if block.settings.mobile_layout == 'vertical' %}
        flex-direction: column;
        text-align: {{ block.settings.mobile_text_alignment }};
      {% endif %}
      gap: {{ block.settings.mobile_spacing }}px;
      padding: {{ block.settings.mobile_padding }}px;
    }

    .ai-brand-blurb-logo-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_logo_size }}px;
      height: {{ block.settings.mobile_logo_size }}px;
      {% if block.settings.mobile_layout == 'vertical' %}
        align-self: {{ block.settings.mobile_logo_alignment }};
      {% endif %}
    }

    .ai-brand-blurb-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_title_size }}px;
    }

    .ai-brand-blurb-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_text_size }}px;
    }
  }
{% endstyle %}

<div
  class="ai-brand-blurb-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-brand-blurb-logo-{{ ai_gen_id }}">
    {% if block.settings.logo %}
      <img
        src="{{ block.settings.logo | image_url: width: 200 }}"
        alt="{{ block.settings.logo.alt | default: shop.name | escape }}"
        loading="lazy"
        width="{{ block.settings.logo_size }}"
        height="{{ block.settings.logo_size }}"
      >
    {% else %}
      <div class="ai-brand-blurb-logo-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="ai-brand-blurb-content-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h3 class="ai-brand-blurb-title-{{ ai_gen_id }}">{{ block.settings.title }}</h3>
    {% endif %}

    {% if block.settings.text != blank %}
      <div class="ai-brand-blurb-text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Brand blurb",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_size",
      "min": 30,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Logo size",
      "default": 60
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Our brand"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Share your brand story and values with your customers. Build trust and connection through authentic storytelling.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "horizontal",
          "label": "Horizontal"
        },
        {
          "value": "vertical",
          "label": "Vertical"
        }
      ],
      "default": "horizontal"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "logo_alignment",
      "label": "Logo alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "spacing",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Spacing between logo and text",
      "default": 20
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#0e0e0e"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#0e0e0e"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Title size",
      "default": 20
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 14
    },
    {
      "type": "range",
      "id": "title_margin_bottom",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Title bottom margin",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        {
          "value": "horizontal",
          "label": "Horizontal"
        },
        {
          "value": "vertical",
          "label": "Vertical"
        }
      ],
      "default": "vertical"
    },
    {
      "type": "select",
      "id": "mobile_text_alignment",
      "label": "Mobile text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "mobile_logo_alignment",
      "label": "Mobile logo alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "mobile_logo_size",
      "min": 25,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Mobile logo size",
      "default": 50
    },
    {
      "type": "range",
      "id": "mobile_title_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Mobile title size",
      "default": 18
    },
    {
      "type": "range",
      "id": "mobile_text_size",
      "min": 12,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Mobile text size",
      "default": 14
    },
    {
      "type": "range",
      "id": "mobile_spacing",
      "min": 8,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Mobile spacing",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_padding",
      "min": 0,
      "max": 30,
      "step": 5,
      "unit": "px",
      "label": "Mobile padding",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "Brand blurb"
    }
  ]
}
{% endschema %}