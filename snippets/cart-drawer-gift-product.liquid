{%- comment -%} JSON for one gift product. Used by snippets/cart-drawer-gift.liquid. {%- endcomment -%}
{
  "id": {{ product.id }},
  "title": {{ product.title | json }},
  "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 400 | json }}{% else %}null{% endif %},
  "options": {{ product.options | json }},
  "variants": [
    {%- for v in product.variants -%}
      {
        "id": {{ v.id }},
        "available": {{ v.available | json }},
        "options": {{ v.options | json }},
        "image": {% if v.featured_image %}{{ v.featured_image | image_url: width: 400 | json }}{% else %}null{% endif %}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}