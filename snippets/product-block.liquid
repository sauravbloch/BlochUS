<div class="product-block {{ grid_class | default: 'grid-flex__item one-quarter small-down--one-half' }}{% if quickbuy %} js-contains-quickbuy{% endif %}" data-product-handle="{{ product.handle }}">
  <div class="product-block__image-container">
    <div class="global-border-radius {% if product.media.size > 1 or settings.product_grid_image_shape == 'natural' or settings.prod_thumb_crop %}hover-images{% endif %} {% if settings.hover_image_enabled == true and product.media.size > 1 %} hover-images--two {% if product.featured_media.preview_image.aspect_ratio == product.media[1].preview_image.aspect_ratio %}same-aspect-ratio{% endif %}{% endif %} relative">
      <a class="product-block__image product-block__image--shape-{{ settings.product_grid_image_shape }} product-block__image--crop-{{ settings.prod_thumb_crop }} product-block__image--valign-{{ settings.prod_thumb_crop_align }}" href="{{ product.url | within: collection }}">
        {%- if product.featured_media != blank -%}
          <div class="image-one">
            {% liquid
              if settings.product_grid_image_shape == 'natural'
                assign aspect_ratio = false
              elsif settings.product_grid_image_shape == 'square'
                assign aspect_ratio = 1.0
              elsif settings.product_grid_image_shape == 'landscape-32'
                assign aspect_ratio = 1.5
              elsif settings.product_grid_image_shape == 'landscape-54'
                assign aspect_ratio = 1.25
              elsif settings.product_grid_image_shape == 'portrait-45'
                assign aspect_ratio = 0.8
              elsif settings.product_grid_image_shape == 'portrait-23'
                assign aspect_ratio = 0.67
              endif
            %}
            {% render 'responsive-image', image: product.featured_media.preview_image, aspect_ratio: aspect_ratio %}
          </div>
          {%- if settings.hover_image_enabled == true and product.media.size > 1 -%}
            <div class="image-two">
              <div class="rimage-background fade-in lazyload global-border-radius"
                   data-bgset="{% render 'bgset', image: product.media[1].preview_image %}"
                   data-sizes="auto"
                   data-parent-fit="cover">
                <noscript>
                  <img src="{{ product.media[1].preview_image | img_url: '1024x1024' }}" alt="{{ product.media[1].preview_image.alt | escape }}" class="rimage-background__image">
                </noscript>
              </div>
            </div>
          {%- endif -%}
        {%- else -%}
          {{- product.featured_media.preview_image | img_url: '600x600' | img_tag -}}
        {%- endif -%}
      </a>

      {% render 'product-badge', product: product, grouped_plp: grouped_plp %}

      {%- if quickbuy -%}
        <a class="product-block__quicklook-btn btn--quicklook btn btn--primary js-quickbuy-button" 
          href="{{ product.url }}" aria-label="{{ 'products.quickbuy.quick_buy' | t }}" aria-describedby="product-price-{{ product.id }}">{% render 'feather-plus' %}</a>
        {% render 'quick-buy-placeholder', product: product, group_handles: group_handles, group_products: group_products, active_handle: active_handle %}
      {%- endif -%}
    </div>
  </div>


  {%- if show_vendor -%}
  <div class="product-block__vendor">
    {{- product.vendor -}}
  </div>
{%- endif -%}

  <div class="product-block-group__meta">
    <div class="product-block-group__meta-main">
      <a href="{{ product.url | within: collection }}" class="product-block-group__title product-block__title-link" id="product-title-{{ product.id }}">
        {{ product.title }}
      </a>
      {%- comment -%}Setting key keeps historical ID for backwards compatibility.{%- endcomment -%}
      {%- if settings.show_legacy_subtitle_plp -%}
        {%- assign plp_subtitle = product.metafields.descriptors.subtitle -%}
        {%- if plp_subtitle != blank -%}
          <div class="product-block-group__subtitle">
            <a href="{{ product.url | within: collection }}" class="product-block-group__subtitle-link product-block__title-link">{{ plp_subtitle }}</a>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
    <div class="product-block-group__price">
      <div class="product-price" id="product-price-{{ product.id }}">
        {%- assign cheapest_variant = product.variants | sort: 'price' | first -%}
        {%- assign productTags = product.tags | join: ', ' -%}
        {% render 'unit-price', variant: cheapest_variant %}

        {% if product.available %}
          {% if cheapest_variant.compare_at_price > cheapest_variant.price and settings.sale_label_enabled %}
            <span class="product-label product-label--on-sale global-border-radius">{{ 'products.product.on_sale' | t }}</span>
          {% endif %}
        {% elsif settings.sold_label_enabled %}
          {% if productTags contains 'coming_soon' %}
            <span class="product-label product-label--on-sale global-border-radius" style="background-color:#000; font-size:10px; ">{{ 'products.product.coming_soon' | t }}</span>
          {% else %}
            <span class="product-label product-label--sold-out global-border-radius">{{ 'products.product.sold_out' | t }}</span>
          {% endif %}
        {% endif %}

        {% if product.price_varies %}
          <span class="product-price__from">{{ 'products.product.from_text' | t }}</span>
        {% endif %}

        <span class="theme_money{% if cheapest_variant.compare_at_price > cheapest_variant.price %} product-price__reduced{% endif %}">
          {%- if settings.product_currency_code_enabled -%}
            {{- cheapest_variant.price | money_with_currency -}}
          {%- else -%}
            {{- cheapest_variant.price | money -}}
          {%- endif -%}
        </span>
        {% if cheapest_variant.compare_at_price > cheapest_variant.price %}
          <span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>
          <span class="product-price__compare theme-money">{{ cheapest_variant.compare_at_price | money }}</span>
        {% endif %}

<!--{% if productTags contains 'bloch-life Apparel' or productTags contains 'bloch-life apparel' or productTags contains 'bloch-life Accessories' %}

<span class="product-label product-label--on-sale global-border-radius" style="background-color:#000; font-size:10px; ">40% OFF AT CHECKOUT</span>
{% endif %}

        {% if productTags contains 'BFCM_dance' %}

<span class="product-label product-label--on-sale global-border-radius" style="background-color:#000; font-size:10px; ">20% OFF AT CHECKOUT</span>
{% endif %}-->

      </div>
    </div>
  </div>

  {%- if settings.swatch_enabled_grid -%}
    {%- comment -%}Pass show_swatches:false from sections to hide grid dots (e.g. PDP recs, promo modules). Omitted = show.{%- endcomment -%}
    {%- unless show_swatches == false -%}
    {%- liquid
      assign plp_grid_mf_style = ''
      assign plp_grid_hex_mf = product.metafields.custom.swatch_hex.value | default: product.metafields.custom.swatch_hex
      assign plp_grid_file_mf = product.metafields.custom.swatch_file.value | default: product.metafields.custom.swatch_file
    -%}
    {%- if plp_grid_file_mf != blank -%}
      {%- assign plp_grid_file_url = plp_grid_file_mf | image_url: width: 128 -%}
      {%- if plp_grid_file_url == blank -%}
        {%- assign plp_grid_file_url = plp_grid_file_mf | file_url -%}
      {%- endif -%}
      {%- if plp_grid_file_url != blank -%}
        {%- assign plp_grid_mf_style = '--grouped-swatch-image:url(' | append: plp_grid_file_url | append: ')' -%}
      {%- endif -%}
    {%- endif -%}
    {%- if plp_grid_mf_style == blank and plp_grid_hex_mf != blank -%}
      {%- assign plp_grid_mf_style = '--grouped-swatch-color:' | append: plp_grid_hex_mf -%}
    {%- endif -%}
    {%- liquid
      assign swatch_count = 0
      assign swatch_mobile_limit = 3
      for product_option in product.options_with_values
        if settings.swatch_enabled_productpage and settings.swatch_option_name contains product_option.name
          assign is_swatch = true
        else
          assign is_swatch = false
        endif
        if is_swatch
          assign product_option_position_0index = product_option.position | minus: 1
          for product_option_value in product_option.values
            assign option_value_variant = false
            for variant in product.variants
              if variant.options[product_option_position_0index] == product_option_value
                assign option_value_variant = variant
                break
              endif
            endfor
            if settings.swatch_method == 'image' and option_value_variant.featured_media == blank and plp_grid_mf_style == blank
              continue
            endif
            assign swatch_count = swatch_count | plus: 1
          endfor
        endif
      endfor
    -%}
    {%- if swatch_count > 0 -%}
      <div class="product-block__swatches product-block-group__swatches">
        <div class="product-block-group__swatch-wrap">
          {%- for product_option in product.options_with_values -%}
            {%- liquid
              if settings.swatch_enabled_productpage and settings.swatch_option_name contains product_option.name
                assign is_swatch = true
              else
                assign is_swatch = false
              endif
            -%}
            {%- if is_swatch == true -%}
              {%- assign product_option_position_0index = product_option.position | minus: 1 -%}
              {%- for product_option_value in product_option.values -%}

                {%- liquid
                  assign option_value_variant = false
                  for variant in product.variants
                    if variant.options[product_option_position_0index] == product_option_value
                      assign option_value_variant = variant
                      break
                    endif
                  endfor

                  if is_swatch and settings.swatch_method == 'image' and option_value_variant.featured_media == blank and plp_grid_mf_style == blank
                    continue
                  endif
                -%}

                <div class="product-block-group__swatch color-swatch-link color-swatch-link-current is-active">
                  {%- if plp_grid_mf_style != blank -%}
                    <span
                      class="product-block-group__swatch-dot related-swatch-img swatch-sample"
                      style="{{ plp_grid_mf_style }}"
                      data-option-item="{{ product_option_value | downcase | escape }}"
                      {%- if settings.swatch_method == 'standard' -%}
                        data-swatch="{{ product_option_value | downcase | replace: '"', '' }}"
                      {%- endif -%}
                    ></span>
                  {%- else -%}
                    <span class="{% if settings.swatch_method == 'image' %}product-swatch-inline__image {% else %}product-swatch-inline__dot product-block-group__swatch-dot related-swatch-img swatch-sample {% endif %}rimage-background fade-in lazyload"
                      data-option-item="{{ product_option_value | downcase | escape }}"
                      {%- if settings.swatch_method == 'standard' -%}
                        data-swatch="{{ product_option_value | downcase | replace: '"', '' }}"
                      {%- elsif settings.swatch_method == 'image' and option_value_variant.featured_media -%}
                        data-bgset="{{ option_value_variant.featured_media.preview_image | img_url: '80x80', crop: settings.swatch_crop_align }}" data-parent-fit="cover"
                      {%- endif -%}></span>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if settings.swatch_method == 'image' and swatch_count > swatch_mobile_limit -%}
            {%- assign remaining = swatch_count | minus: swatch_mobile_limit -%}
            <span class="product-block__swatches-more-label tiny-text">{{ 'collections.general.more_swatches' | t: count: remaining }}</span>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
    {%- endunless -%}
  {%- endif -%}

  {%- unless grouped_plp -%}
    {% render 'product-block-plp-reviews', product: product %}
  {%- endunless -%}
</div>
